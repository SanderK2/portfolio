---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { Font } from "astro:assets";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/SVB_logo.svg" media="(prefers-color-scheme:no-preference)" />
		<link rel="icon" type="image/svg+xml" href="/SVB_logo_white.svg" media="(prefers-color-scheme:dark)" />
		<link rel="icon" type="image/svg+xml" href="/SVB_logo.svg" media="(prefers-color-scheme:light)" />
		<!-- <link rel="icon" href="/favicon.ico" /> -->
		<meta name="generator" content={Astro.generator} />
		<title>Sander Vinkler Bach</title>
		<Font cssVariable="--font-inter" />
	</head>
	<body>
		<Header />
		<slot class="test" />
		<Footer />
	</body>
</html>

<style>
	* {
		--main-theme-color: #d12f13; /* #29abe2 */
		--main-theme-color-secondary: #cd4c35; /* #29abe2aa */
		--text-color-primary: #333;
		--text-color-secondary: #666;
		--background-color: #f5f5f5;
		--ui-divider-color: #d0d0d0;
		--link-color: #007bff;

		--text-color-inverted: #f5f5f5;
	}

	body {
		margin: 0;
		font-family: var(--font-inter), sans-serif;
		background-color: var(--background-color);

		display: flex;
		flex-direction: column;
		min-height: 100vh;
		margin: 0;
	}

	:global(main) {
		flex: 1;
	}
</style>
