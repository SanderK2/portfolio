---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<main>
        <div class="container">
            <h1>About me</h1>
        </div>
	</main>
</BaseLayout>

<style>
	main {
		padding: 2rem;
	}

    h1 {
        font-weight: 400;
        color: var(--text-color-primary);
        margin-bottom: 2rem;
    }

    .container {
        max-width: 60vw;
        margin: 0 auto;
    }

	.projects {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem;
	}

	@media (max-width: 720px) {
		.projects {
			grid-template-columns: 1fr;
		}
	}
</style>