---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<main>
		<div class="container">
			<div class="hero">
				<h1>Sander <span>/</span> Vinkler <span>/</span> Bach</h1>
				<h2>Fullstack Web Developer</h2>
				<p>Hey there! I'm Sander. I build modern web applications with a focus on user experience, performance and sustainability.</p>
				<p>I use technologies like React, Vue, Next.js, Node.js, and Astro.</p>
				<p>While you're here, why not take a look at some of my work?</p>
			</div>
			<div class="links">
				<a href="/projects">View <span>Projects</span></a>
				<a href="/about"><span>About</span> me</a>
				<a href="/contact"><span>Contact</span> me</a>
			</div>
		</div>
	</main>
</BaseLayout>

<style>
	main {
		padding: 2rem;
		display: flex;
		justify-content: center;
		align-items: center;
		flex-direction: column;
	}

	.container {
		max-width: 60vw;
	}

	.hero {
		height: 20rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	h1 {
		font-size: 4rem;
		font-weight: 400;
		color: var(--text-color-primary);
		margin: 0;
	}

	h2 {
		margin: 0;
		font-size: 1.3rem;
		color: var(--main-theme-color);
		font-weight: 300;
		margin-bottom: 2rem;
	}

	p {
		font-size: 1.1rem;
		color: var(--text-color-primary);
		margin: .2rem 0;
		font-weight: 300;
	}

	.links {
		display: flex;
		gap: 1rem;
		width: 100%;
	}

	a {
		text-decoration: none;
		border: 1px solid var(--text-color-primary);
		padding: 1rem 2rem;
		color: var(--text-color-primary);
		border-radius: .5rem;
		flex: 1;
		text-align: center;
		transition: border-color 0.3s, border-radius 0.3s;
	}

	a:hover {
		border-color: var(--main-theme-color);
		border-radius: 0;
	}

	a span:before {
		content: '/';
		margin-right: -.3rem;
		transition: margin-right 0.3s, color 0.3s;
		color: var(--background-color);
	}

	a:hover span:before {
		margin-right: .1rem;
		color: var(--text-color-primary);
	}

	h1 span {
		font-weight: 200;
	}
</style>