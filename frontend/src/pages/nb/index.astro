---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout>
	<main>
		<div class="container">
			<div class="hero">
				<h1>Sander <span>/</span> Vinkler <span>/</span> Bach</h1>
				<h2>Fullstack Webutvikler</h2>
				<p>Heisann! Jeg heter Sander. Jeg bygger moderne web-applikasjoner med et fokus på brukeropplevelse, ytelse og bærekraft.</p>
				<p>Jeg bruker teknologier som React, Vue, Next.js, Node.js, og Astro.</p>
				<p>Når du først er her, hvorfor ikke ta en titt på noe av arbeidet mitt?</p>
			</div>
			<div class="links">
				<a href="/nb/projects">-> Se mine <span>Prosjekter</span></a>
				<a href="/nb/about"><span>Om</span> meg</a>
				<a href="/nb/contact"><span>Kontakt</span> meg</a>
			</div>
		</div>
	</main>
</BaseLayout>

<style>
	main {
		padding: 2rem;
		display: flex;
		justify-content: center;
		align-items: center;
		flex-direction: column;
	}

	.container {
		max-width: 60vw;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.hero {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	h1 {
		font-size: 4rem;
		font-weight: 400;
		color: var(--text-color-primary);
		margin: 0;
	}

	h2 {
		margin: 0;
		font-size: 1.3rem;
		color: var(--main-theme-color);
		font-weight: 300;
		margin-bottom: 2rem;
	}

	p {
		font-size: 1.1rem;
		color: var(--text-color-primary);
		margin: .1rem 0;
		font-weight: 300;
		line-height: 1.6;
	}

	.links {
		display: flex;
		gap: 1rem;
		width: 100%;
	}

	a {
		text-decoration: none;
		border: 1px solid var(--text-color-primary);
		padding: 1rem;
		color: var(--text-color-primary);
		border-radius: .5rem;
		flex: 1;
		text-align: center;
		transition: border-color 0.3s, border-radius 0.3s;
		align-content: center;
	}

	a:hover {
		border-color: var(--main-theme-color);
		border-radius: 0;
	}

	a span:before {
		content: '/';
		margin-right: -.3rem;
		transition: margin-right 0.3s, color 0.3s;
		color: var(--background-color);
	}

	a:hover span:before {
		margin-right: .1rem;
		color: var(--text-color-primary);
	}

	a:first-child {
		background-color: var(--main-theme-color-secondary);
		color: white;
		border-color: var(--main-theme-color);
	}

	a:first-child span:before {
		content: '/';
		margin-right: -.3rem;
		transition: margin-right 0.3s, color 0.3s;
		color: var(--main-theme-color-secondary);
	}

	a:first-child:hover span:before {
		margin-right: .1rem;
		color: var(--text-color-inverted);
	}

	h1 span {
		font-weight: 100;
		color: #797979;
	}

	@media (max-width: 1100px) {
		.links {
			flex-direction: column;
		}
	}

	@media (max-width: 800px) {
		.container {
			max-width: 90vw;
		}

		h1 {
			font-size: 2.5rem;
		}

		h2 {
			margin-top: .5rem;
		}

		.links {
			flex-direction: column;
		}
	}
</style>